{
    "manufacturer": "Shuntaro Kasatani",
    "keyboard_name": "hydropad",
    "maintainer": "Hatya-mouse",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "mousekey": true,
        "extrakey": true,
        "nkro": true,
        "encoder": true,
        "oled": true
    },
    "matrix_pins": {
        "cols": ["GP4", "GP5", "GP21"],
        "rows": ["GP2", "GP3"]
    },
    "processor": "RP2040",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT_matrix_default": {
            "layout": [
                { "matrix": [0, 0], "x": 0, "y": 0 },
                { "matrix": [0, 1], "x": 1, "y": 0 },
                { "matrix": [0, 2], "x": 2, "y": 0 },
                { "matrix": [1, 0], "x": 0, "y": 1 },
                { "matrix": [1, 1], "x": 1, "y": 1 },
                { "matrix": [1, 2], "x": 2, "y": 1 }
            ]
        }
    },
    "encoder": {
        "rotary": [
            {
                "pin_a": "GP20",
                "pin_b": "GP8",
                "resolution": 4
            }
        ]
    }
}
